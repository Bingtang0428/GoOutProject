# ============================================================
# 同行 · 自驾旅行企划 —— 环境变量示例
# 复制为 .env 并填入真实值后即可启用 Supabase。
# 不配置时项目自动运行在「本地演示模式」(localStorage),
# 无需任何后端即可体验全部功能。
# ============================================================

# Supabase Project URL,例如: https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL=

# Supabase anon (public) key
VITE_SUPABASE_ANON_KEY=

# ============================================================
# 高德地图 Web服务 key(functions/api/geocode.js、parse-share.js 用)
# ⚠️ 不是给 Vite 用的:须到 Cloudflare Pages → 项目 → Settings →
#    Environment variables 配置为同名 AMAP_KEY 后重新部署才会生效。
# 申请:控制台 console.amap.com → 应用管理 → 添加 Key →
#   服务平台务必选「Web服务」(选「Web端(JS API)」会返回 10009)。
# 服务器出口为 Cloudflare,若在控制台给 key 绑定了 IP 白名单,
#   Cloudflare 出口 IP 不固定,可能导致 10005 报错,建议不绑定 IP 白名单。
# ============================================================
AMAP_KEY=
